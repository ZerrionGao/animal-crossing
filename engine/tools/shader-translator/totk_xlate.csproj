<!-- Switch Maxwell shader translator based on the licensed Ryujinx shader modules. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RyuSrc Condition="'$(RyuSrc)' == ''">$(MSBuildThisFileDirectory)../../vendor/ryujinx</RyuSrc>
  </PropertyGroup>
  <ItemGroup Condition="'$(OpenSslLibDir)' != ''">
    <LinkerArg Include="-L$(OpenSslLibDir)" />
  </ItemGroup>
  <ItemGroup Condition="'$(BrotliLibDir)' != ''">
    <LinkerArg Include="-L$(BrotliLibDir)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
</Project>
